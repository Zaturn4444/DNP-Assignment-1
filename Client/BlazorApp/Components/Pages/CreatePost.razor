@page "/CreatePost"
@using BlazorApp.Services
@using ApiContracts
@using System.Security.Claims
@inject IPostService postService

<AuthorizeView>
    <Authorized>
        <h3>Create Post</h3>

        <div>
            <label>Title:</label>
            <input type="text" @bind="title" />
        </div>

        <div>
            <label>Body:</label>
            <textarea @bind="body"></textarea>
        </div>

        <button @onclick="Create">Create Post</button>

        @if (!string.IsNullOrEmpty(message))
        {
            <p>@message</p>
        }
    </Authorized>
    <NotAuthorized>
        <p>You must be logged in to create a post.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    public Task<AuthenticationState> State { get; set; } = default!;

    private string title = string.Empty;
    private string body = string.Empty;
    private string message = string.Empty;

    private async Task Create()
    {
        try
        {
            AuthenticationState authState = await State;
            ClaimsPrincipal user = authState.User;

            string? userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (userId == null)
            {
                message = "User is not logged in";
                return;
            }

            CreatePostDto dto = new()
            {
                Title = title,
                Body = body,
                UserId = int.Parse(userId)
            };

            await postService.AddPostAsync(dto);
            message = "Post created successfully";
        }
        catch (Exception e)
        {
            message = e.Message;
        }
    }
}